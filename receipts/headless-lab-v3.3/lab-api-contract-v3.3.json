          "cleanup_terminates_all_and_only_registered_owned_pids": true,
          "verify_cleanup_returns_no_remaining_owned_pids": true,
          "bad_command_propagates_error": true
        },
        "forbidden": [
          "pid = 0 literal",
          "pid = -1 literal",
          "dummy / not-actually / placeholder comments",
          "MagicMock in implementation",
          "global cleanup (killpg/pkill over unowned PIDs)"
        ]
      },
      "JackServer": {
        "required": ["start(sample_rate, period_size)", "stop()"],
        "semantics": "launches the managed JACK server for the lab run and stops it on teardown"
      },
